# =========================
# Python
# =========================
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.ipynb_checkpoints/

# =========================
# OS / editors
# =========================
.DS_Store
.vscode/
.idea/

# =========================
# Data (never commit raw data)
# =========================
data/
**/data/
*.fastq
*.fq
*.bam
*.sam
*.h5
*.hdf5

# =========================
# Outputs (default: ignore all)
# =========================
results/*
**/results/*

# =========================
# EXCLUDE LARGE GENERATED FILES (CRITICAL)
# =========================
results/**/per_clone_denoised_subject.csv
results/**/trajectory_observability_subject.csv
results/**/trajectory_observability_counts_subject.csv
results/**/trajectories_long.csv
results/**/transitions_all.csv
results/**/fitted_values.csv
results/**/diffusion_residuals_long.csv
results/**/null_per_clone_logP*.csv

# =========================
# RE-INCLUDE ONLY FINAL / LIGHT CSV
# =========================
!results/
!results/**/*.csv

# Optional: keep only specific folders clean
# (uncomment if you want stricter control)
# !results/final/
# !results/final/**/*.csv

# =========================
# Logs and figures
# =========================
logs/
**/logs/
*.png
*.pdf

# =========================
# Secrets
# =========================
.env
*.key
*.pem

# =========================
# Sandbox temp
# =========================
sandbox/temp_outputs/